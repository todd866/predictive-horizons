\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textit  {C.~elegans} connectome: oscillatory vs discrete coupling. Same 448-neuron connectome, two architectures. \textbf  {(a)} The oscillatory model (red) carries 16$\times $ more future mutual information than the discrete LIF model (blue dashed) across all prediction lags. \textbf  {(b)} Coupling sweep: predictive content (red) is highest at weak gap junction coupling, where the system maintains moderate dimensionality; stronger coupling collapses $D_{\mathrm  {eff}}$ (black). \textbf  {(c)} At the optimal regime, the oscillatory model has fewer effective dimensions but far more predictive content---each dimension carries environment-relevant information. \textbf  {(d,e)} Motor neuron output: the discrete model produces noisy, unstructured activation; the oscillatory model produces coordinated rhythmic patterns. \textbf  {(f)} Eigenspectra: the oscillatory model distributes variance more broadly across principal components.}}{42}{figure.60}\protected@file@percent }
\newlabel{fig:celegans}{{5}{42}{\textit {C.~elegans} connectome: oscillatory vs discrete coupling. Same 448-neuron connectome, two architectures. \textbf {(a)} The oscillatory model (red) carries 16$\times $ more future mutual information than the discrete LIF model (blue dashed) across all prediction lags. \textbf {(b)} Coupling sweep: predictive content (red) is highest at weak gap junction coupling, where the system maintains moderate dimensionality; stronger coupling collapses $\Deff $ (black). \textbf {(c)} At the optimal regime, the oscillatory model has fewer effective dimensions but far more predictive content---each dimension carries environment-relevant information. \textbf {(d,e)} Motor neuron output: the discrete model produces noisy, unstructured activation; the oscillatory model produces coordinated rhythmic patterns. \textbf {(f)} Eigenspectra: the oscillatory model distributes variance more broadly across principal components}{figure.60}{}}
