\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Prediction lives upstream of code. \textbf  {(a)} Future mutual information $I(X_{\mathrm  {int}}(t); Y_{\mathrm  {env}}(t{+}\Delta t))$ for the full continuous internal state of a 625-oscillator network (red, solid) versus three explicit commit channels with different bandwidths (dashed). Coding destroys most predictive content. \textbf  {(b)} Information lost by coding at short prediction lag: a 5-dimensional, 4-bit commit channel loses $\sim $12 nats of the 14.4 nats available in the continuous state. Even a 20-dimensional channel loses $\sim $8 nats.}}{34}{figure.52}\protected@file@percent }
\newlabel{fig:code_collapse}{{3}{34}{Prediction lives upstream of code. \textbf {(a)} Future mutual information $I(X_{\mathrm {int}}(t); Y_{\mathrm {env}}(t{+}\Delta t))$ for the full continuous internal state of a 625-oscillator network (red, solid) versus three explicit commit channels with different bandwidths (dashed). Coding destroys most predictive content. \textbf {(b)} Information lost by coding at short prediction lag: a 5-dimensional, 4-bit commit channel loses $\sim $12 nats of the 14.4 nats available in the continuous state. Even a 20-dimensional channel loses $\sim $8 nats}{figure.52}{}}
