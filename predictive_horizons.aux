\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The observational gap. Simulation of a $25 \times 25$ oscillator field coupled to a spatiotemporal environment at $K = 22$. \textbf  {(a)} Future mutual information $I_{\mathrm  {pred}}(\Delta t)$ measured at different observer resolutions ($d_{\mathrm  {obs}}$ = number of oscillators whose state is retained; each contributes two PCA dimensions from $[\cos \theta _i, \sin \theta _i]$). The full system (yellow, $d = 625$) carries far more predictive information than any low-dimensional observer can verify. \textbf  {(b)} Short-lag $I_{\mathrm  {pred}}$ as a function of observer dimensionality. The red shaded region is hidden correlation structure---mutual information the system contains but the observer cannot measure. \textbf  {(c)} The information gap opens once coupling is established and depends on both coupling strength and observer resolution: stronger synchronization creates distributed correlations that low-dimensional observers miss, though the relationship is non-monotonic at high coupling strengths.}}{38}{figure.57}\protected@file@percent }
\newlabel{fig:gap}{{4}{38}{The observational gap. Simulation of a $25 \times 25$ oscillator field coupled to a spatiotemporal environment at $K = 22$. \textbf {(a)} Future mutual information $I_{\mathrm {pred}}(\Delta t)$ measured at different observer resolutions ($d_{\mathrm {obs}}$ = number of oscillators whose state is retained; each contributes two PCA dimensions from $[\cos \theta _i, \sin \theta _i]$). The full system (yellow, $d = 625$) carries far more predictive information than any low-dimensional observer can verify. \textbf {(b)} Short-lag $I_{\mathrm {pred}}$ as a function of observer dimensionality. The red shaded region is hidden correlation structure---mutual information the system contains but the observer cannot measure. \textbf {(c)} The information gap opens once coupling is established and depends on both coupling strength and observer resolution: stronger synchronization creates distributed correlations that low-dimensional observers miss, though the relationship is non-monotonic at high coupling strengths}{figure.57}{}}
\citation{still2012}
